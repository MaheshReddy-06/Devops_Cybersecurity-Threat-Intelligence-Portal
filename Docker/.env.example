# =============================================================================
# Docker Environment Variables Example
# Copy to Docker/.env to override default runtime variables
# =============================================================================

# Backend Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Security & Authentication
JWT_SECRET=supersecretthreatinteljwtkey2026!devopsplatform
JWT_EXPIRES_IN=7d

# Initial Administrator Credentials (used when seeding)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@portal.local
ADMIN_PASSWORD=AdminSecurePass2026!

# Frontend Build Arguments
VITE_API_URL=http://localhost:5000/api
