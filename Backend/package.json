{
  "name": "cyber-threat-intelligence-backend",
  "version": "0.1.0",
  "description": "Server API for Cybersecurity Threat Intelligence Sharing Portal",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node utils/seedAdmin.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest tests/auth.test.js",
    "test:threats": "jest tests/threats.test.js",
    "test:admin": "jest tests/admin.test.js",
    "test:dashboard": "jest tests/dashboardAndReports.test.js",
    "test:models": "jest tests/models.test.js",
    "test:integration": "jest tests/integration.test.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/legacy/"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.2"
  }
}
